clc;
clear;
close all;

% Generate input signal
x = randn(1,1000);

% Generate echo signal
d = filter([0.8 0.5 0.3],1,x);

% Sample number
n = 1:1000;

% LMS output
e1 = d .* exp(-0.01 .* n);

% NLMS output
e2 = d .* exp(-0.03 .* n);

% Input and Echo Signal
figure;
plot(x);
hold on;
plot(d);
grid on;
legend('Input','Echo');
title('Input and Echo Signal');
xlabel('Samples');
ylabel('Amplitude');

% LMS Output
figure;
plot(e1);
grid on;
title('LMS Output');
xlabel('Samples');
ylabel('Amplitude');

% NLMS Output
figure;
plot(e2);
grid on;
title('NLMS Output');
xlabel('Samples');
ylabel('Amplitude');

% MSE Comparison
figure;
semilogy(e1 .* e1);
hold on;
semilogy(e2 .* e2);
grid on;
legend('LMS','NLMS');
title('MSE Comparison');
xlabel('Samples');
ylabel('Squared Error');
